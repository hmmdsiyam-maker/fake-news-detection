# POSTGRES DATABASE CONFIGURATION
# If using NeonDB or Render Postgres, uncomment and use DATABASE_URL:
DATABASE_URL=postgresql://user:password@ep-db-name.region.aws.neon.tech/neondb?sslmode=require

# Alternatively, configure individual parts (fallback):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_DB=fake_news_db

# JWT AUTHENTICATION
JWT_SECRET_KEY=fakenews-super-secret-jwt-key-2026-xyz-777

# STRIPE CONFIGURATION
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
